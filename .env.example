# nuvio-sync — copy to .env and edit. Everything here can also be set from /configure
# (data/config.json wins over .env). Never commit a filled-in .env.

# ── server ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=7878
# Base URL advertised in the subtitle links. Set this to your LAN address when Stremio
# runs on another device, e.g. http://192.168.1.10:7878
PUBLIC_URL=
LOG_LEVEL=info
# DATA_DIR=/var/lib/nuvio-sync

# ── subtitle providers ────────────────────────────────────────────────────
ENABLED_PROVIDERS=opensubtitles,subsense,subdl,podnapisi,addons,local
# SubSense (https://github.com/NepiRaw/Stremio-SubSense) — an aggregator that needs no key of
# your own. Point it at your own deployment to skip the public instance and its Wyzie ads.
SUBSENSE_URL=https://subsense.nepiraw.com
# Escape hatch: paste a config segment generated by SubSense's /configure verbatim.
SUBSENSE_CONFIG_PARAM=
SUBSENSE_MAX_SUBTITLES=10
# https://www.opensubtitles.com/en/consumers  (free tier: 5 downloads/day)
OPENSUBTITLES_API_KEY=
# https://subdl.com/api-doc
SUBDL_API_KEY=
# Other Stremio subtitle addons used as sources AND as sync references (comma separated)
STREMIO_SUBTITLE_ADDONS=https://opensubtitles-v3.strem.io/manifest.json

# ── behaviour ─────────────────────────────────────────────────────────────
PREFERRED_LANGS=vi,en
SHOW_ONLY_PREFERRED=false
MAX_SUBTITLES=40

# off  = only apply offsets you set in the Sync Lab
# fast = align against sibling subtitles (+ LLM when a key is set)
# full = fast + audio alignment against the real media
SYNC_MODE=fast
ALLOW_RATE=true
# How long Stremio may wait for the sync before it gets the original file
# (the sync keeps running in the background and the next selection is instant)
AUTO_SYNC_BUDGET_MS=9000
BACKGROUND_SYNC=true
CACHE_TTL_MS=604800000

# ── LLM cue matching (optional; this is Nuvio's AI stage) ─────────────────
# groq   -> https://console.groq.com/keys     default model llama-3.1-8b-instant
# gemini -> https://aistudio.google.com/apikey default model gemini-3.5-flash
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_ATTEMPTS=3

# ── audio alignment (optional) ────────────────────────────────────────────
# Needs ffmpeg and a media file the addon can read (see LOCAL_MEDIA_ROOTS / debrid).
AUDIO_SYNC_ENABLED=false
FFMPEG_PATH=ffmpeg
ALASS_PATH=alass
FFSUBSYNC_PATH=ffsubsync
AUDIO_MAX_ANALYZE_MS=60000
# Analyse only the densest slice of audio (0 = whole file). ffmpeg downloads what it decodes,
# so 600000 turns a 4 GB remote movie into a ~200 MB fetch without changing the offset found.
AUDIO_ANALYZE_WINDOW_MS=0

# ── reaching the actual video file ────────────────────────────────────────
# Media folders scanned to locate the file Stremio is playing (colon separated).
# The OpenSubtitles hash of the candidates is computed and cached to match exactly.
LOCAL_MEDIA_ROOTS=
# realdebrid | torbox | alldebrid — used to turn a pasted magnet into a direct URL
DEBRID_PROVIDER=
DEBRID_API_KEY=

# ── do not set by hand ────────────────────────────────────────────────────
# TOKEN_SECRET is generated into data/config.json on first start, and a fresh one invalidates
# every subtitle link already handed to Stremio. Set it here (any long random string) when
# DATA_DIR does not persist, or when several replicas must accept each other's links.
# TOKEN_SECRET=

# Build identity — baked into the image by CI, surfaced by /healthz. Only set by hand when
# running from source and you want /healthz to report a specific revision.
# GIT_SHA=
# BUILD_TIME=
